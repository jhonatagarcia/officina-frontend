# AutoPro System — Frontend environment variables
# Copy this file to .env and fill in the values

# ── API ──────────────────────────────────────────────────────────────────────
VITE_API_BASE_URL=http://localhost:3000/api/v1
# ── App identity ─────────────────────────────────────────────────────────────
VITE_APP_NAME=AutoPro System

# ── Auth: Google OAuth (optional — leave empty to disable Google login) ──────
VITE_GOOGLE_CLIENT_ID=

# ── Feature flags ────────────────────────────────────────────────────────────
# Set to true to enable the /admin panel
VITE_ADMIN_PANEL_ENABLED=true

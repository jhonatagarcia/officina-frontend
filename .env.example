# Frontend environment variables
# Copy this file to .env.local for private local overrides.
# In Vercel, register these keys in Project Settings > Environment Variables.

# API
VITE_API_BASE_URL=http://localhost:3000/api/v1

# App identity
VITE_APP_NAME=AutoPro System

# Auth: Google OAuth. Leave empty to disable Google login.
VITE_GOOGLE_CLIENT_ID=

# Feature flags
# Set to true to enable the /admin panel.
VITE_ADMIN_PANEL_ENABLED=true

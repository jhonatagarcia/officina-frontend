# Frontend environment variables
# Copy this file to .env for local development.
# In production, VITE_API_BASE_URL can be omitted when the host proxies /api/v1.

# API
# Local development:
VITE_API_BASE_URL=http://localhost:3000/api/v1
#
# Production with same-origin proxy/rewrite:
# VITE_API_BASE_URL=/api/v1
#
# Production without proxy/rewrite:
# VITE_API_BASE_URL=https://api.autoprosystem.com.br/api/v1

# App identity
VITE_APP_NAME=AutoPro System

# Auth: Google OAuth. Leave empty to disable Google login.
VITE_GOOGLE_CLIENT_ID=

# Feature flags
# Set to true to enable the /admin panel.
VITE_ADMIN_PANEL_ENABLED=false

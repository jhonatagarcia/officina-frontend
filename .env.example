# Frontend environment variables
# Copy this file to .env for local development.
# In Vercel, register these keys in Project Settings > Environment Variables.

# API
VITE_API_BASE_URL=https://api.autoprosystem.com.br/api/v1

# App identity
VITE_APP_NAME=AutoPro System

# Auth: Google OAuth. Leave empty to disable Google login.
VITE_GOOGLE_CLIENT_ID=

# Feature flags
# Set to true to enable the /admin panel.
VITE_ADMIN_PANEL_ENABLED=false
